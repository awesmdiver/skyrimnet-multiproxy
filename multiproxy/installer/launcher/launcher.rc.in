// The version resource and icon of the small start program (launcher.c). build_launcher.py fills in the @...@ parts and runs rc.exe on the result.
// Windows reads FileDescription (the name shown in Settings > Apps > Startup) and CompanyName from here.
#include <winver.h>

1 ICON "@ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VERSION_COMMA@
 PRODUCTVERSION @VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@NAME@"
            VALUE "FileDescription", "@NAME@"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "@STEM@"
            VALUE "OriginalFilename", "@FILENAME@"
            VALUE "ProductName", "@NAME@"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
