#!/usr/bin/env bash
# multiproxy-courier: start, stop and look after the MultiProxy Courier on this computer. install.sh puts this in the install folder
# and links it into ~/.local/bin.
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
PY="$DIR/.venv/bin/python"
UNIT=multiproxy-courier.service
# shellcheck source=lib.sh
. "$DIR/lib.sh"
umask 077        # anything this starts (the server, the tray app) writes files for the person alone

# Where this copy keeps its settings, pairing code and log: the folder chosen at install (settings-location.txt).
SETTINGS="${COURIER_SETTINGS_DIR:-}"
if [ -z "$SETTINGS" ] && [ -f "$DIR/settings-location.txt" ]; then SETTINGS="$(tr -d '"\r\n' < "$DIR/settings-location.txt")"; fi
[ -n "$SETTINGS" ] || SETTINGS="$DIR"
LOG="$SETTINGS/courier.log"
PIDFILE="$SETTINGS/courier.pid"
RUN_ARGS=(run --no-tray --no-ready-window --config-dir "$SETTINGS")
[ -n "${COURIER_DISCOVERY_PORT:-}" ] && RUN_ARGS+=(--discovery-port "$COURIER_DISCOVERY_PORT")

have_unit() { command -v systemctl >/dev/null 2>&1 && systemctl --user cat "$UNIT" >/dev/null 2>&1; }
courier() { (cd "$DIR" && "$PY" courier.py "$@"); }
status_text() { courier status --config-dir "$SETTINGS" | sed 's/^Pairing code:.*/Not paired yet. To see the pairing code, run:  multiproxy-courier code/'; }      # (status gets pasted into bug reports: the code is only ever shown by `code`)
running() { courier status --config-dir "$SETTINGS" 2>/dev/null | grep -q 'is running'; }

do_start() {
    if have_unit; then systemctl --user start "$UNIT" || { say "The service didn't start. See why with:  multiproxy-courier logs"; return 1; }
    else
        if running; then say "Courier is already running."; return 0; fi
        mkdir -p "$SETTINGS"
        (cd "$DIR" && exec setsid "$PY" courier.py "${RUN_ARGS[@]}") >>"$SETTINGS/courier.out" 2>&1 </dev/null &
        echo $! > "$PIDFILE"
    fi
    if wait_until 60 running; then status_text; else say "The Courier didn't come up yet. Check on it with:  multiproxy-courier logs"; return 1; fi
}

do_stop() {
    if have_unit; then systemctl --user stop "$UNIT"; return; fi
    if [ -f "$PIDFILE" ]; then
        local p; p="$(cat "$PIDFILE" 2>/dev/null)"
        if pid_is "$p" courier.py; then
            kill "$p" 2>/dev/null || true
            wait_until 20 bash -c '! kill -0 "$1" 2>/dev/null' _ "$p" || kill -9 "$p" 2>/dev/null || true
        fi
        rm -f "$PIDFILE"
    fi
}

do_status() {
    status_text
    if have_unit; then say "Service: $(systemctl --user is-active "$UNIT" 2>/dev/null || true), $(systemctl --user is-enabled "$UNIT" 2>/dev/null | sed 's/^enabled$/starts when you log in/; s/^disabled$/does not start by itself/')"; fi
}

do_logs() {
    if [ ! -f "$LOG" ]; then
        if have_unit; then say "No log file yet. The service's own notes:"; journalctl --user -u "$UNIT" -n 40 --no-pager 2>/dev/null || true; fi
        say "(The log is written once the Courier starts: $LOG)"; return 0
    fi
    say "Following $LOG  (Ctrl+C to leave; the Courier keeps running)"
    exec tail -n 60 -F "$LOG"
}

do_uninstall() {
    local yes=no purge=no a
    for a in "$@"; do case "$a" in --yes|-y) yes=yes ;; --remove-settings) purge=yes ;; *) say "I don't know '$a'. Usage: multiproxy-courier uninstall [--yes] [--remove-settings]"; return 2 ;; esac; done
    if [ "$yes" != yes ] && have_keyboard; then
        ask_yes "Remove the MultiProxy Courier from this computer?" no || { say "Nothing was changed."; return 0; }
        if [ "$purge" != yes ] && ask_yes "Also delete its settings and pairing code ($(tilde "$SETTINGS"))?" no; then purge=yes; fi
    fi
    if [ ! -f "$DIR/$MARKER" ]; then say "This folder wasn't made by the installer, so nothing was removed: $DIR"; return 1; fi
    say "Stopping the Courier…"
    do_stop || true
    if have_unit; then systemctl --user disable --now "$UNIT" >/dev/null 2>&1 || true; fi
    rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT"
    command -v systemctl >/dev/null 2>&1 && systemctl --user daemon-reload >/dev/null 2>&1 || true
    [ "$(readlink -f "$HOME/.local/bin/multiproxy-courier" 2>/dev/null)" = "$DIR/multiproxy-courier" ] && rm -f "$HOME/.local/bin/multiproxy-courier"
    local pointer="${COURIER_INSTALL_INFO:-${XDG_CONFIG_HOME:-$HOME/.config}/skyrimnet-multiproxy-courier/install-info.json}"
    if [ "$(json_field "$pointer" programFolder)" = "$DIR" ]; then rm -f "$pointer"; rmdir "$(dirname "$pointer")" 2>/dev/null || true; fi      # (only the file this install wrote)
    if [ "$purge" = yes ]; then
        case "$SETTINGS" in ""|"/"|"$HOME"|"$DIR") say "(The settings folder looks unsafe to delete, so it was left alone: $SETTINGS)" ;; *) if [ -f "$SETTINGS/$MARKER" ]; then rm -rf "$SETTINGS"; else say "(That folder wasn't made by the installer, so your settings were left alone: $SETTINGS)"; fi ;; esac
    fi
    cd / && rm -rf "$DIR"
    say "The Courier is removed. (If your main device still lists it, remove it there under Other devices.)"
    if [ "$purge" != yes ] && [ -d "$SETTINGS" ] && [ "$SETTINGS" != "$DIR" ]; then say "Its settings and pairing code are still in $SETTINGS (delete that folder to remove them too)."; fi
    exit 0
}

do_help() {
    cat <<'HELP'
multiproxy-courier: look after the MultiProxy Courier on this computer.

  multiproxy-courier start       start it
  multiproxy-courier stop        stop it
  multiproxy-courier restart     stop it, then start it again
  multiproxy-courier status      is it running, and is your main device connected
  multiproxy-courier code        show the pairing code your main device needs (or who this device is already paired with)
  multiproxy-courier new-code    make a new pairing code (the main device has to pair again)
  multiproxy-courier vpn-networks  other VPN or Tailscale networks: list, add 10.8.0.0/16, remove 10.8.0.0/16
  multiproxy-courier ready-window  open the "This device is Ready" window (needs a desktop with Python's tkinter)
  multiproxy-courier logs        follow the log (Ctrl+C to leave)
  multiproxy-courier uninstall   remove it (keeps your settings unless you add --remove-settings; --yes skips the questions)
  multiproxy-courier help        this list
HELP
}

case "${1:-}" in
    start) do_start ;;
    stop) do_stop ;;
    restart) do_stop; sleep 1; do_start ;;
    status) do_status ;;
    code) courier code --config-dir "$SETTINGS" | tail -n 1 ;;
    new-code) courier new-code --config-dir "$SETTINGS" | tail -n 1 ;;
    vpn-networks) shift; courier vpn-networks "$@" --config-dir "$SETTINGS" ;;
    ready-window) courier ready-window --config-dir "$SETTINGS" 2>/dev/null; exit 0 ;;
    logs) do_logs ;;
    uninstall) shift; do_uninstall "$@" ;;
    help|--help|-h|"") do_help ;;
    *) say "I don't know '$1'."; do_help; exit 2 ;;
esac
