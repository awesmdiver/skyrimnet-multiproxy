# Build artifacts
build/
out/
*.dll
*.pdb
*.log

# Release packaging (build-release.ps1) -- release-staging/ holds the files sourced from the
# private skyrimnet-multiproxy-dev repo at release-build time (proxy.py, requirements.txt,
# config.example.json, proxy.ini.example, start-proxy.bat), never committed here since this repo
# isn't their source of truth. github-releases/ is the built zip output, a reproducible artifact.
release-staging/
github-releases/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Visual Studio
.vs/
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln

# VCPKG
vcpkg_installed/

# Vendor folder (if using manual setup)
vendor/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Board-owned lifecycle state (claude-workflow-board) -- checkoff/sent-session state, never committed
prompts/.board-state.json

# Rotating recovery backups of .board-state.json (claude-workflow-board, queue: board-state-backup-rotation) -- never committed
prompts/.board-state.json.bak*

# SQLite hybrid-architecture spike index (derived + rebuildable -- BUILD-PROMPT-sqlite-hybrid-spike.md)
prompts/.board-index.sqlite*

# Session action log (claude-workflow-board) -- board actions + undo state, not code history
prompts/.session-log.json

# Local browse-convenience handoff archive (claude-workflow-board) -- not the durable record
prompts/handoffs/

# Per-item handoff snapshots (claude-workflow-board) -- which archived handoff belongs to which item
prompts/.item-handoffs/

# Local roadmap images (claude-workflow-board) -- personal working files, not repo content.
# The README banner is the one real repo asset in here.
assets/*
!assets/readme-banner.jpg
!assets/release-banner-v2-3-0.jpg
